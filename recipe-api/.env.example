# =====================================================================
# recipe-api .env.example
# Copy to .env and fill in real values. Never commit a populated .env.
# =====================================================================

# ---- Database (self-hosted Postgres 16 on the VPS) -------------------
# Created by scripts/vps/02_create_db_and_roles.sh. The script prints
# this connection string on first run — copy it verbatim.
DATABASE_URL=postgresql://recipe_app:CHANGE_ME@localhost:5432/recipe_base

# Max clients in the pg.Pool per Node.js process. The API uses one pool
# per worker, so total Postgres connection budget ≈ PG_POOL_MAX × (api + 2 workers + 1 auditor).
PG_POOL_MAX=10

# ---- OFF mirror (same Postgres cluster, different DB) ----------------
# Already in place pre-migration. Used by openFoodFacts.ts for sub-ms
# barcode + text lookups, with the live OFF API as a fallback.
OFF_DB_URL=postgresql://off_user:off_mirror_2026@localhost:5432/off_mirror

# ---- HTTP server -----------------------------------------------------
PORT=3034
NODE_ENV=production

# ---- Third-party APIs (unchanged from pre-migration) -----------------
# USDA FoodData Central — raw ingredients per-100g lookup.
# Register a separate key for local dev so you don't share production quota:
# https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# FatSecret — IP-whitelisted in their developer dashboard. Production
# server's IP must be registered there; local dev calls will 403.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# API Ninjas — NOT used in the production chain (free tier blocks
# calories + protein). Key stored but the service returns null unless
# the account is upgraded.
API_NINJAS_KEY=

# Resend — transactional email for /auth/request-key.
RESEND_API_KEY=

# ---- Observability (optional) ----------------------------------------
# If set, scripts/vps/05_health_check.sh POSTs failure events here
# (Slack incoming webhook, Discord webhook, healthchecks.io, etc.).
HEALTHCHECK_WEBHOOK=
